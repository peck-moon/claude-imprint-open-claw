# Copy this file to .env and fill in your values
# The .env file is gitignored and stays local on your machine

# Discord webhook URL for notifications
# Get it from: Discord channel → Edit Channel → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url-here

# Telegram (optional, if you use Telegram instead)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Timezone offset from UTC (e.g. 8 for Beijing/Shanghai)
TZ_OFFSET=8

# Heartbeat interval in seconds (default: 900 = 15 min)
# HEARTBEAT_INTERVAL=900
